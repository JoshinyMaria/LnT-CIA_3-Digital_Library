{
  "info": {
    "_postman_id": "e2e00000-0000-4000-8000-000000000001",
    "name": "Digital Library Management System",
    "description": "End-to-end test collection: Register → Login (JWT) → Search → Issue → Borrowing limit → Return → Fine → Payment → History → Hold → Notification → Reports. Includes ownership (403) and RBAC (403) negative tests. Run from top to bottom in order.",
