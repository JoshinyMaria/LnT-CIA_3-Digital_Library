            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/register"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"E2E Member\",\n  \"email\": \"e2e@student.com\",\n  \"password\": \"password123\",\n  \"memberType\": \"student\",\n  \"phone\": \"1234567890\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"status 201\", function(){ pm.expect(pm.response.code).to.eql(201); });",
              "var j=pm.response.json(); pm.test(\"role forced to member\", function(){ pm.expect(j.data.user.role).to.eql(\"member\"); });\n       if(j.success){ pm.collectionVariables.set(\"memberId\", j.data.user._id); pm.collectionVariables.set(\"e2eToken\", j.data.token); }"
            ]
          }
        }
      ]
    },
